<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_EnergyPilot" targetNamespace="https://example.org/energy-regression-pipeline" exporter="Poster assets generator" exporterVersion="1.0">
  <bpmn:error id="InvalidTrialError" name="Invalid trial" errorCode="INVALID_TRIAL" />
  <bpmn:dataStore id="RegistryStore" name="Versioned image registry" />
  <bpmn:process id="EnergyRegressionPipeline" name="Planned energy-regression experiment pipeline" isExecutable="false">
    <bpmn:documentation>Proposed workflow, not an implemented CI/CD pipeline. User configures variants, durations, repetitions, users and seed. Trial instances run sequentially in randomized block order. Quiet references before/after each trial are a conservative proposed policy; duration and cadence must be decided before execution. Readiness, smoke or data validation failures signal INVALID_TRIAL and interrupt the subprocess. Analysis publishes pass/fail/inconclusive status; actual detection must be validated on independent A/A and A/B experiments.</bpmn:documentation>
    <bpmn:subProcess id="trial" name="Execute randomized trial plan">
      <bpmn:incoming>f_build_trial</bpmn:incoming>
      <bpmn:outgoing>f_trial_analyze</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">number_of_planned_trials</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="trialStart">
        <bpmn:outgoing>i_start</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="deploy" name="Deploy pinned variant; readiness + smoke checks">
        <bpmn:documentation>Signals the INVALID_TRIAL BPMN error if readiness, smoke, sample continuity, cutoff alignment or request quality checks fail.</bpmn:documentation>
        <bpmn:incoming>i_start</bpmn:incoming>
        <bpmn:outgoing>i_deploy_pre</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="preQuiet" name="Quiet reference before trial">
        <bpmn:incoming>i_deploy_pre</bpmn:incoming>
        <bpmn:outgoing>i_pre_fork</bpmn:outgoing>
      </bpmn:task>
      <bpmn:parallelGateway id="fork">
        <bpmn:incoming>i_pre_fork</bpmn:incoming>
        <bpmn:outgoing>i_fork_load</bpmn:outgoing>
        <bpmn:outgoing>i_fork_monitor</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:task id="load" name="Run seeded Locust warm-up → measure → guard (external)">
        <bpmn:incoming>i_fork_load</bpmn:incoming>
        <bpmn:outgoing>i_load_join</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="telemetry" name="Capture telemetry Kepler → Prometheus + request timings">
        <bpmn:incoming>i_fork_monitor</bpmn:incoming>
        <bpmn:outgoing>i_monitor_join</bpmn:outgoing>
      </bpmn:task>
      <bpmn:parallelGateway id="join">
        <bpmn:incoming>i_load_join</bpmn:incoming>
        <bpmn:incoming>i_monitor_join</bpmn:incoming>
        <bpmn:outgoing>i_join_post</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:task id="postQuiet" name="Quiet reference after trial">
        <bpmn:incoming>i_join_post</bpmn:incoming>
        <bpmn:outgoing>i_post_valid</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="validate" name="Align cutoffs; validate metrics and request results">
        <bpmn:documentation>Signals the INVALID_TRIAL BPMN error if readiness, smoke, sample continuity, cutoff alignment or request quality checks fail.</bpmn:documentation>
        <bpmn:incoming>i_post_valid</bpmn:incoming>
        <bpmn:outgoing>i_valid_end</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="trialEnd">
        <bpmn:incoming>i_valid_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="i_start" sourceRef="trialStart" targetRef="deploy" />
      <bpmn:sequenceFlow id="i_deploy_pre" sourceRef="deploy" targetRef="preQuiet" />
      <bpmn:sequenceFlow id="i_pre_fork" sourceRef="preQuiet" targetRef="fork" />
      <bpmn:sequenceFlow id="i_fork_load" sourceRef="fork" targetRef="load" />
      <bpmn:sequenceFlow id="i_fork_monitor" sourceRef="fork" targetRef="telemetry" />
      <bpmn:sequenceFlow id="i_load_join" sourceRef="load" targetRef="join" />
      <bpmn:sequenceFlow id="i_monitor_join" sourceRef="telemetry" targetRef="join" />
      <bpmn:sequenceFlow id="i_join_post" sourceRef="join" targetRef="postQuiet" />
      <bpmn:sequenceFlow id="i_post_valid" sourceRef="postQuiet" targetRef="validate" />
      <bpmn:sequenceFlow id="i_valid_end" sourceRef="validate" targetRef="trialEnd" />
    </bpmn:subProcess>
    <bpmn:startEvent id="start" name="Manual trigger">
      <bpmn:outgoing>f_start_config</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="configure" name="Configure experiment record environment + pipeline start time">
      <bpmn:incoming>f_start_config</bpmn:incoming>
      <bpmn:outgoing>f_config_build</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="build" name="Build revision(s) and publish pinned container images">
      <bpmn:incoming>f_config_build</bpmn:incoming>
      <bpmn:outgoing>f_build_trial</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObject id="configRef_Data" name="Durations · repetitions users · seed · variants" />
    <bpmn:dataObjectReference id="configRef" name="Durations · repetitions users · seed · variants" dataObjectRef="configRef_Data" />
    <bpmn:dataObject id="sourceRef_Data" name="Source revision(s)" />
    <bpmn:dataObjectReference id="sourceRef" name="Source revision(s)" dataObjectRef="sourceRef_Data" />
    <bpmn:dataStoreReference id="registryRef" name="Versioned local image registry" dataStoreRef="RegistryStore" />
    <bpmn:boundaryEvent id="qualityError" name="Quality gate failed" attachedToRef="trial" cancelActivity="true">
      <bpmn:outgoing>f_quality_failure</bpmn:outgoing>
      <bpmn:errorEventDefinition id="CatchInvalidTrial" errorRef="InvalidTrialError" />
    </bpmn:boundaryEvent>
    <bpmn:task id="failure" name="Save diagnostics and fail the job">
      <bpmn:incoming>f_quality_failure</bpmn:incoming>
      <bpmn:outgoing>f_failure_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="failedEnd" name="Job failed">
      <bpmn:incoming>f_failure_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="metricsRef_Data" name="Raw energy + request metrics" />
    <bpmn:dataObjectReference id="metricsRef" name="Raw energy + request metrics" dataObjectRef="metricsRef_Data" />
    <bpmn:task id="analyze" name="Compare A/A + A/B CV · detection rate · false alarms">
      <bpmn:incoming>f_trial_analyze</bpmn:incoming>
      <bpmn:outgoing>f_analyze_publish</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="publish" name="Publish CSV + figures pipeline timings and job status">
      <bpmn:incoming>f_analyze_publish</bpmn:incoming>
      <bpmn:outgoing>f_publish_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="finished" name="Finished">
      <bpmn:incoming>f_publish_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_config" sourceRef="start" targetRef="configure" />
    <bpmn:sequenceFlow id="f_config_build" sourceRef="configure" targetRef="build" />
    <bpmn:sequenceFlow id="f_build_trial" sourceRef="build" targetRef="trial" />
    <bpmn:sequenceFlow id="f_quality_failure" sourceRef="qualityError" targetRef="failure" />
    <bpmn:sequenceFlow id="f_failure_end" sourceRef="failure" targetRef="failedEnd" />
    <bpmn:sequenceFlow id="f_trial_analyze" sourceRef="trial" targetRef="analyze" />
    <bpmn:sequenceFlow id="f_analyze_publish" sourceRef="analyze" targetRef="publish" />
    <bpmn:sequenceFlow id="f_publish_end" sourceRef="publish" targetRef="finished" />
    <bpmn:association id="a_config" sourceRef="configRef" targetRef="configure" associationDirection="One" />
    <bpmn:association id="a_source" sourceRef="sourceRef" targetRef="build" associationDirection="One" />
    <bpmn:association id="a_registry" sourceRef="build" targetRef="registryRef" associationDirection="One" />
    <bpmn:association id="a_metrics" sourceRef="telemetry" targetRef="metricsRef" associationDirection="One" />
    <bpmn:association id="a_metrics_analyze" sourceRef="metricsRef" targetRef="analyze" associationDirection="One" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_EnergyPipeline">
    <bpmndi:BPMNPlane id="Plane_EnergyPipeline" bpmnElement="EnergyRegressionPipeline">
      <bpmndi:BPMNShape id="Shape_start" bpmnElement="start">

{
  "apiVersion": "monitoring.coreos.com/v1",
  "kind": "ServiceMonitor",
  "metadata": {
    "annotations": {
      "meta.helm.sh/release-name": "kepler",
      "meta.helm.sh/release-namespace": "kepler"
    },
    "labels": {
      "app.kubernetes.io/instance": "kepler",
      "app.kubernetes.io/managed-by": "Helm",
      "app.kubernetes.io/name": "kepler",
      "app.kubernetes.io/part-of": "kepler",
      "app.kubernetes.io/version": "v0.13.0",
      "helm.sh/chart": "kepler-0.13.0",
      "release": "prometheus"
    },
    "name": "kepler",
    "namespace": "kepler"
  },
  "spec": {
    "endpoints": [
      {
        "interval": "5s",
        "path": "/metrics",
        "port": "http"
      }
    ],
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/instance": "kepler",
        "app.kubernetes.io/name": "kepler"
      }
    }
  }
}
